---
const faqs = [
  {
    q: 'Which editors can install it?',
    a: 'VS Code 1.96 or later. The same extension is on Open VSX for Cursor, Windsurf, Trae, and other compatible editors. Agents launched with npx need Node.js 20 or later.',
  },
  {
    q: 'Do I need an account?',
    a: 'No. Install the extension and use the agent logins you already have.',
  },
  {
    q: 'Is ACP Pro free?',
    a: 'The core workflow is free. A Pro license adds browser-access controls: a persistent access code, an owner password, and a read-only or full-write mode.',
  },
  {
    q: 'Can browser access be turned off?',
    a: 'Yes. Each workspace has its own switch under Settings → Bridge Server.',
  },
];
---

<section class="section faq">
  <div class="page-shell">
    <div class="section-heading">
      <div class="rule-tick" aria-hidden="true"></div>
      <p class="eyebrow">FAQ</p>
      <div class="rule" aria-hidden="true"></div>
      <h2>
        Short answers before you install.
        <span class="muted-line">Editors, account, price, and remote access.</span>
      </h2>
      <div class="rule" aria-hidden="true"></div>
    </div>
    <div class="faq-grid">
      {
        faqs.map((item) => (
          <article>
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--bg);
  }

  .section-heading .eyebrow {
    padding: 0.85rem 0;
  }

  .section-heading h2 {
    padding: 1rem 0;
    margin: 0;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin-top: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .faq-grid article {
    padding: 1.25rem 1.15rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--panel);
  }

  .faq-grid article:nth-child(2n) {
    border-right: none;
  }

  .faq-grid article:nth-last-child(-n + 2) {
    border-bottom: none;
  }

  .faq-grid h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.35;
    font-weight: 600;
  }

  .faq-grid p {
    margin: 0.65rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  @media (max-width: 680px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }

    .faq-grid article {
      border-right: none;
    }

    .faq-grid article:nth-last-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }

    .faq-grid article:last-child {
      border-bottom: none;
    }
  }
</style>
