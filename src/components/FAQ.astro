---
// @spec: cap-product-homepage/screenshot-led-workflow-story#understand-remote-access-beyond-teammate-sharing
const faqs = [
  {
    q: 'Which VS Code version is required?',
    a: 'ACP Pro requires VS Code 1.96 or later and Node.js 20 or later for agents launched through npx.',
  },
  {
    q: 'Does ACP Pro only work with one provider?',
    a: 'No. ACP Pro speaks Agent Client Protocol, so it can work with Claude Code, Codex CLI, Copilot CLI, Gemini CLI, Qwen Code, OpenCode, and any compatible agent.',
  },
  {
    q: 'Is the extension free?',
    a: 'The core extension is free to install and use. A Pro license unlocks optional browser-access controls such as a persistent access code and owner password.',
  },
  {
    q: 'Can remote browser access be disabled?',
    a: 'Yes. Browser access can be turned off per workspace from the Bridge Server settings.',
  },
];
---

<section class="section faq">
  <div class="page-shell">
    <div class="section-heading">
      <div class="rule-tick" aria-hidden="true"></div>
      <p class="eyebrow">FAQ</p>
      <div class="rule" aria-hidden="true"></div>
      <h2>
        Short answers before you install.
        <span class="muted-line">Requirements, providers, license, and remote access.</span>
      </h2>
      <div class="rule" aria-hidden="true"></div>
    </div>
    <div class="faq-grid">
      {
        faqs.map((item) => (
          <article>
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--bg);
  }

  .section-heading .eyebrow {
    padding: 0.85rem 0;
  }

  .section-heading h2 {
    padding: 1rem 0;
    margin: 0;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin-top: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .faq-grid article {
    padding: 1.25rem 1.15rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--panel);
  }

  .faq-grid article:nth-child(2n) {
    border-right: none;
  }

  .faq-grid article:nth-last-child(-n + 2) {
    border-bottom: none;
  }

  .faq-grid h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.35;
    font-weight: 600;
  }

  .faq-grid p {
    margin: 0.65rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  @media (max-width: 680px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }

    .faq-grid article {
      border-right: none;
    }

    .faq-grid article:nth-last-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }

    .faq-grid article:last-child {
      border-bottom: none;
    }
  }
</style>
