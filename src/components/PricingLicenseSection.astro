---
import { ArrowUpRight, Check, KeyRound } from '@lucide/astro';

const included = [
  'Core ACP chat experience remains free',
  'Persistent custom browser access code',
  'Owner password for browser control',
  'Read-only/full-write browser toggle',
  'One activation across a VS Code client profile',
  'Offline-resilient validated license state',
];
---

<!-- @spec: cap-product-homepage/screenshot-led-workflow-story#understand-remote-access-beyond-teammate-sharing -->
<section id="license" class="section license">
  <div class="page-shell license-grid">
    <div class="license-card dark-surface">
      <p class="eyebrow">License</p>
      <KeyRound size={22} aria-hidden="true" />
      <h2>
        Free to use.
        <span class="muted-line">Pro adds control for browser access.</span>
      </h2>
      <p>
        Every core agent workflow stays free. A Pro activation follows your VS
        Code client profile across local and remote workspaces while protected
        host keys keep the browser-access entitlement bound to approved environments.
      </p>
      <a class="button button-primary" href="https://duclvz.gumroad.com/l/acp-pro">
        Get a Pro license
        <ArrowUpRight size={16} aria-hidden="true" />
      </a>
    </div>
    <div class="included surface">
      <p class="eyebrow">What Pro adds</p>
      <ul>
        {
          included.map((item) => (
            <li>
              <Check size={16} aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .license {
    background: var(--bg-subtle);
    border-block: 1px solid var(--line);
  }

  .license-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.7fr);
    gap: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .license-card,
  .included {
    border: none;
    border-radius: 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .license-card .eyebrow {
    color: #7d7d7d;
    margin: 0 0 1.1rem;
  }

  .license-card svg {
    color: var(--accent);
  }

  .license-card h2 {
    max-width: 28rem;
    margin: 1.1rem 0 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.022em;
    text-wrap: pretty;
  }

  .license-card h2 .muted-line {
    display: block;
    color: #a3a3a3;
    font-weight: 600;
  }

  .license-card p {
    max-width: 36rem;
    margin: 1.1rem 0 0;
    color: #a3a3a3;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .license-card .button {
    margin-top: 1.5rem;
  }

  .included {
    border-left: 1px solid var(--line-strong);
    background: var(--panel);
  }

  .included ul {
    display: grid;
    gap: 0;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .included li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    border-top: 1px solid var(--line);
    padding: 0.85rem 0;
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .included li:first-child {
    border-top: none;
    padding-top: 0;
  }

  .included li svg {
    margin-top: 2px;
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .license-grid {
      grid-template-columns: 1fr;
    }

    .included {
      border-left: none;
      border-top: 1px solid var(--line-strong);
    }
  }
</style>
