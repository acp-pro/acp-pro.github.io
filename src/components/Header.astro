---
import { ArrowUpRight, Download, GitBranch, Menu } from '@lucide/astro';
---

<!-- @spec: cap-product-homepage/screenshot-led-workflow-story#understand-remote-access-beyond-teammate-sharing -->
<header class="site-header">
  <div class="page-shell header-inner">
    <a class="brand" href="/" aria-label="ACP Pro home">
      <img src="/assets/icon.png" alt="" width="32" height="32" />
      <span>ACP Pro</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="#workflow">How it works</a>
      <a href="#features">Features</a>
      <a href="#agents">Agents</a>
      <a href="#sharing">Remote access</a>
      <a href="#license">License</a>
    </nav>
    <div class="header-actions">
      <a
        class="icon-link"
        href="https://github.com/acp-pro/acp-pro.github.io"
        aria-label="Open ACP Pro on GitHub"
      >
        <GitBranch size={18} aria-hidden="true" />
      </a>
      <a
        class="button button-dark install-link"
        href="https://marketplace.visualstudio.com/items?itemName=duclvz.acp-pro"
      >
        <Download size={17} aria-hidden="true" />
        Install
        <ArrowUpRight size={16} aria-hidden="true" />
      </a>
      <details class="mobile-menu">
        <summary aria-label="Open navigation menu">
          <Menu size={20} aria-hidden="true" />
        </summary>
        <div class="mobile-menu-panel">
          <nav aria-label="Mobile navigation">
            <a href="#workflow">How it works</a>
            <a href="#features">Features</a>
            <a href="#agents">Agents</a>
            <a href="#sharing">Remote access</a>
            <a href="#license">License</a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .header-inner {
    display: grid;
    min-height: 64px;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
  }

  .brand,
  .header-actions,
  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 10px;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .brand:focus-visible {
    outline-offset: 4px;
    border-radius: 6px;
  }

  .brand img {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-strong);
  }

  .desktop-nav {
    justify-content: center;
    gap: clamp(14px, 2.5vw, 28px);
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .desktop-nav a {
    padding: 0.35rem 0.1rem;
    transition: color var(--dur-state) var(--ease-feedback);
  }

  .desktop-nav a:hover {
    color: var(--ink);
  }

  .desktop-nav a:focus-visible {
    outline-offset: 4px;
    border-radius: 4px;
  }

  .header-actions {
    justify-content: flex-end;
    gap: 8px;
  }

  .icon-link {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    transition:
      background var(--dur-state) var(--ease-feedback),
      border-color var(--dur-state) var(--ease-feedback),
      color var(--dur-state) var(--ease-feedback);
  }

  .icon-link:hover {
    background: var(--bg-subtle);
    border-color: oklch(14.5% 0 0 / 0.22);
    color: var(--ink);
  }

  .icon-link:focus-visible {
    outline-offset: 3px;
  }

  .install-link {
    min-height: 40px;
    padding-inline: 0.95rem;
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    list-style: none;
    transition:
      background var(--dur-state) var(--ease-feedback),
      border-color var(--dur-state) var(--ease-feedback),
      color var(--dur-state) var(--ease-feedback);
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary:hover {
    background: var(--bg-subtle);
    border-color: oklch(14.5% 0 0 / 0.22);
  }

  .mobile-menu summary:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .mobile-menu[open] summary {
    background: var(--ink);
    border-color: var(--ink);
    color: #fafafa;
  }

  .mobile-menu-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(280px, calc(100vw - 32px));
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 8px;
    background: var(--panel);
    box-shadow: 0 12px 40px oklch(14.5% 0 0 / 0.08);
  }

  .mobile-menu-panel nav {
    display: grid;
    gap: 2px;
  }

  .mobile-menu-panel a {
    display: block;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
    transition: background var(--dur-tap) var(--ease-feedback);
  }

  .mobile-menu-panel a:hover {
    background: var(--bg-subtle);
  }

  .mobile-menu-panel a:focus-visible {
    outline-offset: -2px;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 840px) {
    .header-inner {
      grid-template-columns: auto 1fr auto;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 480px) {
    .site-header {
      position: static;
    }

    .install-link {
      width: 40px;
      padding: 0;
      font-size: 0;
    }

    .install-link svg:last-child {
      display: none;
    }
  }
</style>
