---
import { ArrowUpRight, Download } from '@lucide/astro';
import { formatCount, type InstallCounts } from '../data/installs';

interface Props {
  counts: InstallCounts;
}

const { counts } = Astro.props;
---

<section class="section close" aria-labelledby="install-heading">
  <div class="page-shell close-inner">
    <p class="eyebrow">Install</p>
    <h2 id="install-heading">Run it in the editor you already use.</h2>
    <p>
      {
        `${formatCount(counts.total)} across both registries — ${formatCount(counts.marketplaceInstalls)} Marketplace installs and ${formatCount(counts.openVsxDownloads)} Open VSX downloads.`
      }
    </p>
    <div class="close-actions">
      <a
        class="button button-primary"
        href="https://marketplace.visualstudio.com/items?itemName=duclvz.acp-pro"
      >
        <Download size={18} aria-hidden="true" />
        Install for VS Code
        <ArrowUpRight size={16} aria-hidden="true" />
      </a>
      <a class="text-link" href="https://open-vsx.org/extension/duclvz/acp-pro">
        Install from Open VSX
        <ArrowUpRight size={16} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<style>
  .close {
    background: var(--bg-subtle);
    border-top: 1px solid var(--line);
  }

  .close-inner {
    max-width: 40rem;
  }

  .close h2 {
    margin: 0.7rem 0 0;
    font-size: clamp(1.85rem, 4.2vw, 2.75rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.022em;
    text-wrap: pretty;
  }

  .close p {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .close-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    margin-top: 1.5rem;
  }

  .text-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }

  .text-link:hover {
    color: var(--muted);
  }

  @media (max-width: 620px) {
    .close-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .text-link {
      justify-content: center;
    }
  }
</style>
