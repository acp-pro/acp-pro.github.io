---
import { ArrowUpRight } from '@lucide/astro';

// @spec: static-product-homepage#view-product-homepage
const agents = [
  'Claude Code',
  'Codex',
  'Grok Build',
  'OpenCode',
  'GitHub Copilot',
  'Qwen Code',
  'Auggie CLI',
  'Qoder CLI',
  'OpenClaw',
];
---

<section id="agents" class="agent-band">
  <div class="page-shell agent-inner">
    <div class="agent-copy">
      <p class="eyebrow">Agent compatibility</p>
      <h2>
        Built-ins, ready to launch.
        <span class="muted-line">Now with a dedicated editor-tab settings experience.</span>
      </h2>
      <p>
        Start any built-in agent through its maintained ACP command, or add more
        compatible agents from the growing ACP Registry.
      </p>
      <a
        class="registry-link"
        href="https://agentclientprotocol.com/get-started/registry"
      >
        Browse the ACP Registry
        <ArrowUpRight size={16} aria-hidden="true" />
      </a>
    </div>
    <div class="agent-list" aria-label="Supported default agents">
      {agents.map((agent) => <span>{agent}</span>)}
      <a href="https://agentclientprotocol.com/get-started/registry">
        More agents
        <ArrowUpRight size={14} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<style>
  .agent-band {
    border-block: 1px solid #262626;
    padding: clamp(2.75rem, 5vw, 3.75rem) 0;
    background: var(--panel-strong);
    color: #f5f5f5;
  }

  .agent-inner {
    display: grid;
    grid-template-columns: minmax(240px, 0.72fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(28px, 5vw, 48px);
  }

  .agent-copy .eyebrow {
    color: #7d7d7d;
  }

  .agent-copy h2 {
    margin: 0.7rem 0 0;
    font-size: clamp(1.6rem, 3.4vw, 2.35rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .agent-copy h2 .muted-line {
    display: block;
    color: #a3a3a3;
    font-weight: 600;
  }

  .agent-copy p {
    max-width: 28rem;
    margin: 0.9rem 0 0;
    color: #a3a3a3;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .registry-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 1.1rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: opacity var(--dur-tap) var(--ease-feedback);
  }

  .registry-link:hover {
    opacity: 0.85;
  }

  .registry-link:focus-visible {
    outline-offset: 4px;
  }

  .agent-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .agent-list span,
  .agent-list a {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    gap: 5px;
    border: 1px solid #2f2f2f;
    border-radius: 999px;
    padding: 0.45rem 0.72rem;
    background: transparent;
    color: #e5e5e5;
    font-size: 0.8125rem;
    font-weight: 500;
    transition:
      background var(--dur-state) var(--ease-feedback),
      border-color var(--dur-state) var(--ease-feedback);
  }

  .agent-list span:hover {
    background: #1f1f1f;
    border-color: #3f3f3f;
  }

  .agent-list a {
    border-color: rgba(0, 208, 132, 0.35);
    background: rgba(0, 208, 132, 0.08);
    color: #9cf5cd;
  }

  .agent-list a:hover {
    background: rgba(0, 208, 132, 0.14);
    border-color: rgba(0, 208, 132, 0.5);
  }

  .agent-list a:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  @media (max-width: 780px) {
    .agent-inner {
      grid-template-columns: 1fr;
    }

    .agent-list {
      justify-content: flex-start;
    }
  }
</style>
