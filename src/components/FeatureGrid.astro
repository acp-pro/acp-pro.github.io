---
import {
  Bot,
  Braces,
  ClipboardList,
  FileDiff,
  FolderGit2,
  Keyboard,
  MonitorCog,
  PanelsTopLeft,
  RefreshCcw,
} from '@lucide/astro';

// @spec: cap-product-homepage/screenshot-led-workflow-story#understand-the-end-to-end-workflow
const featureGroups = [
  {
    number: '01',
    title: 'Agent workspace',
    summary: 'Choose the right agent and keep each task’s context separate.',
    features: [
      {
        icon: PanelsTopLeft,
        title: 'Parallel sessions, isolated context',
        body: 'Give every task its own history, model, permission mode, and working directory.',
      },
      {
        icon: MonitorCog,
        title: 'Agent setup without JSON editing',
        body: 'Browse the registry, add agents, reorder them, test commands, and manage updates visually.',
      },
      {
        icon: Bot,
        title: 'ACP-native, not provider-locked',
        body: 'Bring any Agent Client Protocol implementation into the same VS Code workspace.',
      },
    ],
  },
  {
    number: '02',
    title: 'Visible execution',
    summary: 'Follow the plan, inspect the evidence, and keep results readable.',
    features: [
      {
        icon: ClipboardList,
        title: 'Plans stay readable',
        body: 'Track execution in a task panel while reasoning stays in a separate expandable block.',
      },
      {
        icon: FileDiff,
        title: 'Tool work you can inspect',
        body: 'Follow tool calls as they stream, with clear status, changed-line totals, and inline diffs.',
      },
      {
        icon: Braces,
        title: 'Results keep their useful shape',
        body: 'Review Markdown, code, images, audio, diffs, resources, and links in the timeline.',
      },
    ],
  },
  {
    number: '03',
    title: 'Continuity and control',
    summary: 'Keep the codebase attached and recover without rebuilding the session.',
    features: [
      {
        icon: FolderGit2,
        title: 'Codebase context stays attached',
        body: 'Keep each tab’s cwd, branch, staged changes, stash, and ahead/behind state visible.',
      },
      {
        icon: Keyboard,
        title: 'Prompt from where you code',
        body: 'Use commands and skills, mention files or line ranges, attach context, or send a selection.',
      },
      {
        icon: RefreshCcw,
        title: 'Sessions recover gracefully',
        body: 'Restore tabs after reloads, replay history, or start fresh when an agent drops a session.',
      },
    ],
  },
];
---

<section id="features" class="section features">
  <div class="page-shell">
    <div class="section-heading">
      <div class="rule-tick" aria-hidden="true"></div>
      <p class="eyebrow">Built for daily work</p>
      <div class="rule" aria-hidden="true"></div>
      <h2>
        Depth where the workflow needs it.
        <span class="muted-line">Choice, evidence, state, and recovery.</span>
      </h2>
      <div class="rule" aria-hidden="true"></div>
      <p>
        The screenshots show the flow. Underneath it, ACP Pro keeps agent choice,
        execution evidence, codebase state, and recovery organized for repeated use.
      </p>
      <div class="rule" aria-hidden="true"></div>
    </div>

    <div class="feature-groups">
      {
        featureGroups.map((group) => (
          <article class="feature-group">
            <header class="feature-group-heading">
              <span aria-hidden="true">{group.number}</span>
              <h3>{group.title}</h3>
              <p>{group.summary}</p>
            </header>
            <div class="feature-list">
              {group.features.map((feature) => {
                const Icon = feature.icon;
                return (
                  <div class="feature-item">
                    <Icon size={18} aria-hidden="true" />
                    <div>
                      <h4>{feature.title}</h4>
                      <p>{feature.body}</p>
                    </div>
                  </div>
                );
              })}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    background: var(--bg-subtle);
    border-block: 1px solid var(--line);
  }

  .section-heading .eyebrow {
    padding: 0.85rem 0;
  }

  .section-heading h2 {
    padding: 1rem 0;
    margin: 0;
  }

  .section-heading > p {
    padding: 1rem 0;
    margin: 0;
  }

  .feature-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--panel);
    overflow: hidden;
  }

  .feature-group {
    min-width: 0;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border-right: 1px solid var(--line);
  }

  .feature-group:last-child {
    border-right: none;
  }

  .feature-group-heading span {
    display: inline-flex;
    color: var(--muted-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .feature-group-heading h3 {
    margin: 0.7rem 0 0;
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .feature-group-heading p {
    margin: 0.55rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .feature-list {
    display: grid;
    margin-top: 1.25rem;
  }

  .feature-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    border-top: 1px solid var(--line);
    padding: 1rem 0;
  }

  .feature-item:last-child {
    padding-bottom: 0;
  }

  .feature-item svg {
    margin-top: 2px;
    color: var(--muted);
  }

  .feature-item h4 {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.3;
    font-weight: 600;
  }

  .feature-item p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  @media (max-width: 960px) {
    .feature-groups {
      grid-template-columns: 1fr;
    }

    .feature-group {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }

    .feature-group:last-child {
      border-bottom: none;
    }
  }
</style>
