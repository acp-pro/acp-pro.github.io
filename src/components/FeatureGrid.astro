---
import {
  Bot,
  Braces,
  ClipboardList,
  FileDiff,
  FolderGit2,
  Keyboard,
  MonitorCog,
  PanelsTopLeft,
  RefreshCcw,
} from '@lucide/astro';

// @spec: static-product-homepage#view-product-homepage
const featureGroups = [
  {
    number: '01',
    title: 'Session workspace',
    summary: 'Move between active and recent work without losing each tab’s setup.',
    features: [
      {
        icon: PanelsTopLeft,
        title: 'One switcher for every session',
        body: 'Search Live and Recent conversations, close live sessions, and restore their history later.',
      },
      {
        icon: FolderGit2,
        title: 'Per-tab cwd and fork',
        body: 'Choose a working directory from the header, then fork a tab with the same agent, model, mode, and cwd.',
      },
      {
        icon: RefreshCcw,
        title: 'Bounded live processes',
        body: 'Cap live agents and dehydrate finished idle sessions while active work, drafts, prompts, and remote views stay live.',
      },
    ],
  },
  {
    number: '02',
    title: 'Visible execution',
    summary: 'Follow the plan, inspect the evidence, and keep results readable.',
    features: [
      {
        icon: ClipboardList,
        title: 'Plans stay readable',
        body: 'Track execution in a task panel while reasoning stays in a separate expandable block.',
      },
      {
        icon: FileDiff,
        title: 'Tool work you can inspect',
        body: 'Follow tool calls as they stream, with clear status, changed-line totals, and inline diffs.',
      },
      {
        icon: Braces,
        title: 'Stable rich answers',
        body: 'Stream GitHub-Flavored Markdown without flicker, with highlighted code, LaTeX, clickable paths, and scrollable tables.',
      },
    ],
  },
  {
    number: '03',
    title: 'Continuity and control',
    summary: 'Keep prompts, agent controls, and long transcripts steady as work evolves.',
    features: [
      {
        icon: Keyboard,
        title: 'Compose now or send later',
        body: 'Mention files and selections, attach context, queue follow-ups, or set a compact timer such as 4m or 1h4m.',
      },
      {
        icon: Bot,
        title: 'Controls match each agent',
        body: 'Switch permission mode, model, reasoning effort, and extra select controls the active agent advertises.',
      },
      {
        icon: MonitorCog,
        title: 'Reading position stays put',
        body: 'Long transcripts preserve each tab’s reading position and follow-at-bottom intent when you switch sessions.',
      },
    ],
  },
];
---

<section id="features" class="section features">
  <div class="page-shell">
    <div class="section-heading">
      <div class="rule-tick" aria-hidden="true"></div>
      <p class="eyebrow">Built for daily work</p>
      <div class="rule" aria-hidden="true"></div>
      <h2>
        Depth where the workflow needs it.
        <span class="muted-line">Choice, evidence, state, and recovery.</span>
      </h2>
      <div class="rule" aria-hidden="true"></div>
      <p>
        The screenshots show the flow. Underneath it, ACP Pro keeps agent choice,
        execution evidence, codebase state, and recovery organized for repeated use.
      </p>
      <div class="rule" aria-hidden="true"></div>
    </div>

    <div class="feature-groups">
      {
        featureGroups.map((group) => (
          <article class="feature-group">
            <header class="feature-group-heading">
              <span aria-hidden="true">{group.number}</span>
              <h3>{group.title}</h3>
              <p>{group.summary}</p>
            </header>
            <div class="feature-list">
              {group.features.map((feature) => {
                const Icon = feature.icon;
                return (
                  <div class="feature-item">
                    <Icon size={18} aria-hidden="true" />
                    <div>
                      <h4>{feature.title}</h4>
                      <p>{feature.body}</p>
                    </div>
                  </div>
                );
              })}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    background: var(--bg-subtle);
    border-block: 1px solid var(--line);
  }

  .section-heading .eyebrow {
    padding: 0.85rem 0;
  }

  .section-heading h2 {
    padding: 1rem 0;
    margin: 0;
  }

  .section-heading > p {
    padding: 1rem 0;
    margin: 0;
  }

  .feature-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--panel);
    overflow: hidden;
  }

  .feature-group {
    min-width: 0;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border-right: 1px solid var(--line);
  }

  .feature-group:last-child {
    border-right: none;
  }

  .feature-group-heading span {
    display: inline-flex;
    color: var(--muted-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .feature-group-heading h3 {
    margin: 0.7rem 0 0;
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .feature-group-heading p {
    margin: 0.55rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .feature-list {
    display: grid;
    margin-top: 1.25rem;
  }

  .feature-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    border-top: 1px solid var(--line);
    padding: 1rem 0;
  }

  .feature-item:last-child {
    padding-bottom: 0;
  }

  .feature-item svg {
    margin-top: 2px;
    color: var(--muted);
  }

  .feature-item h4 {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.3;
    font-weight: 600;
  }

  .feature-item p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  @media (max-width: 960px) {
    .feature-groups {
      grid-template-columns: 1fr;
    }

    .feature-group {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }

    .feature-group:last-child {
      border-bottom: none;
    }
  }
</style>
