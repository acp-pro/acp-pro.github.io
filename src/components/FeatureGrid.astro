---
import {
  AtSign,
  Braces,
  ClipboardList,
  FileDiff,
  FolderGit2,
  History,
  KeyRound,
  MonitorSmartphone,
  Palette,
  PanelsTopLeft,
  RefreshCcw,
  SendHorizontal,
  SlidersHorizontal,
} from '@lucide/astro';

const featureGroups = [
  {
    number: '01',
    title: 'Sessions and agents',
    summary: 'Keep every conversation separate, with its own agent, directory, and history.',
    features: [
      {
        icon: PanelsTopLeft,
        title: 'Multiple agents and sessions',
        body: 'Pick an agent per session and switch between Live and Recent in one sidebar — browse by directory, reopen earlier work, or close a live session while keeping its history.',
      },
      {
        icon: FolderGit2,
        title: 'Working directories and actions',
        body: 'Each tab shows its working directory, connection state, agent version, and git branch. Browse folders, fork or duplicate a session, export or search the transcript, and pick a directory per tab.',
      },
      {
        icon: RefreshCcw,
        title: 'Resumable history, bounded sessions',
        body: 'The last session restores on reload; finished idle sessions release after 60 minutes while drafts, scheduled prompts, permissions, and remote views stay protected. Default cap of eight live sessions, both limits configurable.',
      },
    ],
  },
  {
    number: '02',
    title: 'Context and input',
    summary: 'Give the agent precise context and control when each follow-up lands.',
    features: [
      {
        icon: AtSign,
        title: 'Files, selections, and attachments',
        body: 'Type @ to mention files and ranges, paste or drag attachments with preview, and send the active editor selection (Ctrl+Alt+L / Cmd+Alt+L). Supports slash commands and skills.',
      },
      {
        icon: SendHorizontal,
        title: 'Queue, steer, or stop and send',
        body: 'Sending mid-turn queues to Pending; steer the running turn when available or stop and send the replacement. Requires Claude ACP adapter 0.84.0 for native steering; otherwise stop-and-send.',
      },
      {
        icon: History,
        title: 'Prompt history and timers',
        body: 'Press ↑/↓ at the composer to recall session prompts and restore the draft caret. Add a delay like 4m or 1h4m to schedule a draft or queued prompt.',
      },
      {
        icon: SlidersHorizontal,
        title: 'Session controls and usage',
        body: 'Per-session model, permission mode, and reasoning/effort controls (e.g. Codex fast mode). Inline input/output, cache, window, and cost metrics with exact values on hover.',
      },
    ],
  },
  {
    number: '03',
    title: 'Visible execution',
    summary: 'Follow the plan, inspect the evidence, and keep answers readable.',
    features: [
      {
        icon: ClipboardList,
        title: 'Plans and reasoning',
        body: 'Execution plans in a collapsible task panel; agent reasoning in a separate expandable block so the transcript stays focused.',
      },
      {
        icon: FileDiff,
        title: 'Tool calls and inline diffs',
        body: 'Reads, edits, shell commands, and searches stream with status; diffs show changed-line totals and word-level highlights with clickable paths resolved to the session cwd.',
      },
      {
        icon: Braces,
        title: 'Rich answers',
        body: 'GFM Markdown, code, scrollable tables, LaTeX, and Mermaid diagrams with pan, zoom, copy-source, and SVG export. Images, audio, and resource blocks render inline.',
      },
    ],
  },
  {
    number: '04',
    title: 'Access and workspace',
    summary: 'Follow work from any device and tailor the workspace to your flow.',
    features: [
      {
        icon: MonitorSmartphone,
        title: 'Browser sharing',
        body: 'Copy a share URL from the ACP status bar to open the live workspace in a browser — phone or desktop — via LAN or VS Code port forwarding. Per-workspace toggle in Settings → Bridge Server.',
      },
      {
        icon: KeyRound,
        title: 'Optional Pro controls',
        body: 'Persistent share code, owner password, and an owner-only read-only/full-write toggle for browser viewers. Activate once in Settings → License across the same VS Code client profile.',
      },
      {
        icon: Palette,
        title: 'Appearance and diagnostics',
        body: 'System/Dark/Light themes (plus sun/moon toggle) and a reusable Settings editor. Run ACP Pro: Toggle Debug Mode for live ACP request/response logs in the Output panel.',
      },
    ],
  },
];
---

<section id="features" class="section features">
  <div class="page-shell">
    <div class="section-heading">
      <div class="rule-tick" aria-hidden="true"></div>
      <p class="eyebrow">Built for daily work</p>
      <div class="rule" aria-hidden="true"></div>
      <h2>
        Depth where the workflow needs it.
        <span class="muted-line">Choice, evidence, state, and recovery.</span>
      </h2>
      <div class="rule" aria-hidden="true"></div>
      <p>
        The screenshots show the flow. Underneath it, ACP Pro keeps agent choice,
        execution evidence, codebase state, and recovery organized for repeated use.
      </p>
      <div class="rule" aria-hidden="true"></div>
    </div>

    <div class="feature-groups">
      {
        featureGroups.map((group) => (
          <article class="feature-group">
            <header class="feature-group-heading">
              <span aria-hidden="true">{group.number}</span>
              <h3>{group.title}</h3>
              <p>{group.summary}</p>
            </header>
            <div class="feature-list">
              {group.features.map((feature) => {
                const Icon = feature.icon;
                return (
                  <div class="feature-item">
                    <Icon size={18} aria-hidden="true" />
                    <div>
                      <h4>{feature.title}</h4>
                      <p>{feature.body}</p>
                    </div>
                  </div>
                );
              })}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    background: var(--bg-subtle);
    border-block: 1px solid var(--line);
  }

  .section-heading .eyebrow {
    padding: 0.85rem 0;
  }

  .section-heading h2 {
    padding: 1rem 0;
    margin: 0;
  }

  .section-heading > p {
    padding: 1rem 0;
    margin: 0;
  }

  .feature-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--panel);
    overflow: hidden;
  }

  .feature-group {
    min-width: 0;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border-right: 1px solid var(--line);
  }

  .feature-group:last-child {
    border-right: none;
  }

  .feature-group-heading span {
    display: inline-flex;
    color: var(--muted-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .feature-group-heading h3 {
    margin: 0.7rem 0 0;
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .feature-group-heading p {
    margin: 0.55rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .feature-list {
    display: grid;
    margin-top: 1.25rem;
  }

  .feature-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    border-top: 1px solid var(--line);
    padding: 1rem 0;
  }

  .feature-item:last-child {
    padding-bottom: 0;
  }

  .feature-item svg {
    margin-top: 2px;
    color: var(--muted);
  }

  .feature-item h4 {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.3;
    font-weight: 600;
  }

  .feature-item p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  @media (max-width: 960px) {
    .feature-groups {
      grid-template-columns: 1fr;
    }

    .feature-group {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }

    .feature-group:last-child {
      border-bottom: none;
    }
  }
</style>
