---
import {
  AtSign,
  Braces,
  ClipboardList,
  FileDiff,
  FolderGit2,
  History,
  KeyRound,
  MonitorSmartphone,
  Palette,
  PanelsTopLeft,
  RefreshCcw,
  SendHorizontal,
  SlidersHorizontal,
} from '@lucide/astro';

const demoIntro = [
  {
    number: '01',
    title: 'Start a session',
    body: 'The demo opens on the built-in grid. Claude Code starts the chat, and the session switcher keeps that live thread apart from Recent history.',
  },
  {
    number: '02',
    title: 'Send the context',
    body: 'The prompt names @src/server.ts and attaches rate-limits.md, so the route file and the spec go out together.',
  },
  {
    number: '03',
    title: 'Review the diff',
    body: 'The rate limiter streams as an inline edit, with Allow, Always allow edits, and Reject on the change.',
  },
  {
    number: '04',
    title: 'Queue the follow-up',
    body: '“Then add tests for the limiter” waits in the composer while the turn is still running, then goes out with Stop & send.',
  },
  {
    number: '05',
    title: 'Read the evidence',
    body: 'The answer lands as a limit table and a Mermaid diagram. Tasks, the token window, and the cost stay next to the model and permission mode.',
  },
  {
    number: '06',
    title: 'Set the defaults',
    body: 'Settings opens beside the chat: the default agent, each command and its arguments, plus remote control, license, and appearance.',
  },
  {
    number: '07',
    title: 'Send from the phone',
    body: 'The same session opens in the browser. “Make the limit configurable via env” is sent from the phone composer.',
  },
];

const featureGroups = [
  {
    number: '01',
    title: 'Sessions and agents',
    summary: 'Keep every conversation separate, with its own agent, directory, and history.',
    features: [
      {
        icon: PanelsTopLeft,
        title: 'Multiple agents and sessions',
        body: 'Pick an agent per session and switch between Live and Recent in one sidebar — browse by directory, reopen earlier work, or close a live session while keeping its history.',
      },
      {
        icon: FolderGit2,
        title: 'Working directories and actions',
        body: 'Each tab shows its working directory, connection state, agent version, and git branch. Browse folders, fork or duplicate a session, export or search the transcript, and pick a directory per tab.',
      },
      {
        icon: RefreshCcw,
        title: 'Resumable history, bounded sessions',
        body: 'The last session restores on reload; finished idle sessions release after 60 minutes while drafts, scheduled prompts, permissions, and remote views stay protected. Default cap of eight live sessions, both limits configurable.',
      },
    ],
  },
  {
    number: '02',
    title: 'Context and input',
    summary: 'Give the agent precise context and control when each follow-up lands.',
    features: [
      {
        icon: AtSign,
        title: 'Files, selections, and attachments',
        body: 'Type @ to mention files and ranges, paste or drag attachments with preview, and send the active editor selection (Ctrl+Alt+L / Cmd+Alt+L). Supports slash commands and skills.',
      },
      {
        icon: SendHorizontal,
        title: 'Queue, steer, or stop and send',
        body: 'Sending mid-turn queues to Pending; steer the running turn when available or stop and send the replacement. Requires Claude ACP adapter 0.84.0 for native steering; otherwise stop-and-send.',
      },
      {
        icon: History,
        title: 'Prompt history and timers',
        body: 'Press ↑/↓ at the composer to recall session prompts and restore the draft caret. Add a delay like 4m or 1h4m to schedule a draft or queued prompt.',
      },
      {
        icon: SlidersHorizontal,
        title: 'Session controls and usage',
        body: 'Per-session model, permission mode, and reasoning/effort controls (e.g. Codex fast mode). Inline input/output, cache, window, and cost metrics with exact values on hover.',
      },
    ],
  },
  {
    number: '03',
    title: 'Visible execution',
    summary: 'Follow the plan, inspect the evidence, and keep answers readable.',
    features: [
      {
        icon: ClipboardList,
        title: 'Plans and reasoning',
        body: 'Execution plans in a collapsible task panel; agent reasoning in a separate expandable block so the transcript stays focused.',
      },
      {
        icon: FileDiff,
        title: 'Tool calls and inline diffs',
        body: 'Reads, edits, shell commands, and searches stream with status; diffs show changed-line totals and word-level highlights with clickable paths resolved to the session cwd.',
      },
      {
        icon: Braces,
        title: 'Rich answers',
        body: 'GFM Markdown, code, scrollable tables, LaTeX, and Mermaid diagrams with pan, zoom, copy-source, and SVG export. Images, audio, and resource blocks render inline.',
      },
    ],
  },
  {
    number: '04',
    title: 'Access and workspace',
    summary: 'Follow work from any device and tailor the workspace to your flow.',
    features: [
      {
        icon: MonitorSmartphone,
        title: 'Browser sharing',
        body: 'Copy a share URL from the ACP status bar to open the live workspace in a browser — phone or desktop — via LAN or VS Code port forwarding. Per-workspace toggle in Settings → Bridge Server.',
      },
      {
        icon: KeyRound,
        title: 'Optional Pro controls',
        body: 'Persistent share code, owner password, and an owner-only read-only/full-write toggle for browser viewers. Activate once in Settings → License across the same VS Code client profile.',
      },
      {
        icon: Palette,
        title: 'Appearance and diagnostics',
        body: 'System/Dark/Light themes (plus sun/moon toggle) and a reusable Settings editor. Run ACP Pro: Toggle Debug Mode for live ACP request/response logs in the Output panel.',
      },
    ],
  },
];
---

<section id="features" class="section features">
  <div class="page-shell">
    <div class="section-heading">
      <div class="rule-tick" aria-hidden="true"></div>
      <p class="eyebrow">Built for daily work</p>
      <div class="rule" aria-hidden="true"></div>
      <h2>
        Depth where the workflow needs it.
        <span class="muted-line">Choice, evidence, state, and recovery.</span>
      </h2>
      <div class="rule" aria-hidden="true"></div>
      <p>
        One pass through a real task. The loop shows it; these are the moves.
      </p>
      <div class="rule" aria-hidden="true"></div>
    </div>

    <div class="feature-demo">
      <figure class="feature-gif dark-surface">
        <img
          class="gif"
          src="/assets/acp-pro-demo.gif"
          alt="ACP Pro demo: start a Claude Code session, review the rate-limiter diff, then continue the same session on a phone"
          width="800"
          height="500"
          loading="lazy"
          decoding="async"
        />
        <img
          class="still"
          src="/assets/acp-pro-demo-poster.jpg"
          alt="ACP Pro in VS Code with the agent picker beside an open TypeScript file"
          width="1280"
          height="800"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <ol class="demo-intro">
      {
        demoIntro.map((beat) => (
          <li>
            <span>{beat.number}</span>
            <h3>{beat.title}</h3>
            <p>{beat.body}</p>
          </li>
        ))
      }
      </ol>
    </div>

    <p class="feature-bridge">
      Under that pass, ACP Pro keeps agent choice, execution evidence, codebase
      state, and recovery organized for repeated use.
    </p>

    <div class="feature-groups">
      {
        featureGroups.map((group) => (
          <article class="feature-group">
            <header class="feature-group-heading">
              <span aria-hidden="true">{group.number}</span>
              <h3>{group.title}</h3>
              <p>{group.summary}</p>
            </header>
            <div class="feature-list">
              {group.features.map((feature) => {
                const Icon = feature.icon;
                return (
                  <div class="feature-item">
                    <Icon size={18} aria-hidden="true" />
                    <div>
                      <h4>{feature.title}</h4>
                      <p>{feature.body}</p>
                    </div>
                  </div>
                );
              })}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    background: var(--bg-subtle);
    border-block: 1px solid var(--line);
  }

  .section-heading .eyebrow {
    padding: 0.85rem 0;
  }

  .section-heading h2 {
    padding: 1rem 0;
    margin: 0;
  }

  .section-heading h2 .muted-line {
    display: block;
  }

  .section-heading > p {
    padding: 1rem 0;
    margin: 0;
  }

  .feature-demo {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.85fr);
    gap: clamp(16px, 3vw, 32px);
    align-items: start;
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
  }

  .feature-gif {
    position: sticky;
    top: 76px;
    margin: 0;
    overflow: hidden;
  }

  .feature-gif img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 800 / 500;
    background: #0c0f12;
  }

  .feature-gif .still {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-gif .gif {
      display: none;
    }

    .feature-gif .still {
      display: block;
    }
  }

  .demo-intro {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--panel);
    overflow: hidden;
  }

  .demo-intro li {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 14px;
    align-items: baseline;
    margin: 0;
    padding: 1rem 1.1rem 1.05rem;
    border-bottom: 1px solid var(--line);
  }

  .demo-intro li:last-child {
    border-bottom: none;
  }

  .demo-intro span {
    grid-row: 1 / span 2;
    color: var(--muted-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .demo-intro h3 {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .demo-intro p {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .feature-bridge {
    max-width: 40rem;
    margin: clamp(1.5rem, 3vw, 2rem) 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.6vw, 1.0625rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .feature-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--panel);
    overflow: hidden;
  }

  .feature-group {
    min-width: 0;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border-right: 1px solid var(--line);
  }

  .feature-group:last-child {
    border-right: none;
  }

  .feature-group-heading span {
    display: inline-flex;
    color: var(--muted-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .feature-group-heading h3 {
    margin: 0.7rem 0 0;
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .feature-group-heading p {
    margin: 0.55rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .feature-list {
    display: grid;
    margin-top: 1.25rem;
  }

  .feature-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    border-top: 1px solid var(--line);
    padding: 1rem 0;
  }

  .feature-item:last-child {
    padding-bottom: 0;
  }

  .feature-item svg {
    margin-top: 2px;
    color: var(--muted);
  }

  .feature-item h4 {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.3;
    font-weight: 600;
  }

  .feature-item p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  @media (max-width: 960px) {
    .feature-demo,
    .feature-groups {
      grid-template-columns: 1fr;
    }

    .feature-gif {
      position: static;
    }

    .feature-group {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }

    .feature-group:last-child {
      border-bottom: none;
    }
  }
</style>
