---
import { ArrowUpRight, Download } from '@lucide/astro';
---

<!-- @spec: cap-product-homepage/screenshot-led-workflow-story#understand-remote-access-beyond-teammate-sharing -->
<section class="hero">
  <div class="page-shell hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">VS Code extension · Agent Client Protocol</p>
      <h1>One ACP Client for every AI agent.</h1>
      <p class="hero-lede">
        Open Claude Code, Codex, Copilot, Gemini, and other ACP agents side by
        side. Keep each task's model, permissions, working directory, git state,
        and history in its own tab—then open the live workspace in a browser
        when you step away or want a second set of eyes.
      </p>
    </div>

    <div class="hero-visual" aria-label="ACP Pro product preview">
      <div class="window dark-surface">
        <img
          src="/assets/acp-pro-demo.gif"
          alt="ACP Pro running parallel AI coding-agent sessions with visible tasks and controls"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="hero-actions">
        <a
          class="button button-primary"
          href="https://marketplace.visualstudio.com/items?itemName=duclvz.acp-pro"
        >
          <Download size={18} aria-hidden="true" />
          Install from Marketplace
          <ArrowUpRight size={16} aria-hidden="true" />
        </a>
        <a
          class="button button-ghost"
          href="https://open-vsx.org/extension/duclvz/acp-pro"
        >
          <Download size={18} aria-hidden="true" />
          Install from Open VSX
          <ArrowUpRight size={16} aria-hidden="true" />
        </a>
      </div>
      <p class="compat-note">
        Open VSX supports VS Code-compatible IDEs including Cursor, Windsurf,
        Trae, and similar editors.
      </p>
      <!-- @spec: cap-product-homepage/static-product-homepage#view-product-homepage -->
      <dl class="hero-stats" aria-label="Product highlights">
        <div>
          <dt>Release</dt>
          <dd>0.2.7</dd>
        </div>
        <div>
          <dt>Agents</dt>
          <dd>Any ACP</dd>
        </div>
        <div>
          <dt>Sessions</dt>
          <dd>Parallel</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(64px, 9vw, 128px) 0 36px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr);
    align-items: center;
    gap: clamp(34px, 6vw, 76px);
  }

  .hero-copy h1 {
    max-width: 760px;
    margin: 18px 0 0;
    font-size: clamp(2.8rem, 6.4vw, 5.6rem);
    line-height: 0.96;
    letter-spacing: -0.025em;
  }

  .hero-lede {
    max-width: 640px;
    margin: 28px 0 0;
    color: var(--muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .compat-note {
    max-width: 560px;
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 28px;
    margin: 28px 0 0;
  }

  .hero-stats div {
    border-left: 2px solid var(--line);
    padding-left: 16px;
  }

  .hero-stats dt {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-stats dd {
    margin: 4px 0 0;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .hero-visual {
    min-width: 0;
  }

  .window {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px;
  }

  .window.dark-surface:hover {
    transform: none;
    box-shadow: 0 24px 70px rgba(12, 14, 16, 0.22);
  }

  .window img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    background: #0c0f12;
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .hero {
      padding-top: 42px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-stats {
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .hero-stats div {
      padding-left: 12px;
    }

    .hero-stats dd {
      font-size: 1.35rem;
    }
  }
</style>
