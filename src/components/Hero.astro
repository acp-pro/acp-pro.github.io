---
import { ArrowUpRight, Download } from '@lucide/astro';
---

<!-- @spec: cap-product-homepage/screenshot-led-workflow-story#understand-remote-access-beyond-teammate-sharing -->
<section class="hero">
  <div class="page-shell">
    <div class="hero-copy">
      <p class="eyebrow">ACP Pro · VS Code · Agent Client Protocol</p>
      <h1>
        One ACP Client for every AI agent.
        <span class="muted-line">Sessions stay visible when you step away.</span>
      </h1>
      <p class="hero-lede">
        Open Claude Code, Codex, Copilot, Gemini, and other ACP agents side by
        side. Keep each task's model, permissions, working directory, git state,
        and history in its own tab—then open the live workspace in a browser
        when you step away or want a second set of eyes.
      </p>
      <div class="hero-actions">
        <a
          class="button button-primary"
          href="https://marketplace.visualstudio.com/items?itemName=duclvz.acp-pro"
        >
          <Download size={18} aria-hidden="true" />
          Install from Marketplace
          <ArrowUpRight size={16} aria-hidden="true" />
        </a>
        <a
          class="button button-ghost"
          href="https://open-vsx.org/extension/duclvz/acp-pro"
        >
          <Download size={18} aria-hidden="true" />
          Install from Open VSX
          <ArrowUpRight size={16} aria-hidden="true" />
        </a>
      </div>
      <p class="compat-note">
        Free core · Open VSX for Cursor, Windsurf, Trae, and similar editors · No
        account required
      </p>
    </div>

    <div class="hero-media" aria-label="ACP Pro product preview">
      <div class="rule-tick" aria-hidden="true"></div>
      <div class="window dark-surface">
        <img
          src="/assets/acp-pro-demo.gif"
          alt="ACP Pro running parallel AI coding-agent sessions with visible tasks and controls"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="rule" aria-hidden="true"></div>
      <!-- @spec: cap-product-homepage/static-product-homepage#view-product-homepage -->
      <dl class="hero-stats" aria-label="Product highlights">
        <div>
          <dt>release</dt>
          <dd>0.3.0</dd>
          <p>Current public build</p>
        </div>
        <div>
          <dt>agents</dt>
          <dd>Any ACP</dd>
          <p>Registry + defaults</p>
        </div>
        <div>
          <dt>sessions</dt>
          <dd>Parallel</dd>
          <p>Isolated context per tab</p>
        </div>
      </dl>
      <div class="rule" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 0;
  }

  .hero-copy {
    max-width: 46rem;
    padding-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }

  .hero-copy h1 {
    margin: 0.85rem 0 0;
    font-size: clamp(2.25rem, 5.4vw, 3.75rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.028em;
    text-wrap: pretty;
  }

  .hero-copy h1 .muted-line {
    display: block;
    color: var(--muted);
    font-weight: 600;
  }

  .hero-lede {
    max-width: 40rem;
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: clamp(1.02rem, 1.8vw, 1.125rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 1.5rem;
  }

  .compat-note {
    margin: 1rem 0 0;
    color: var(--muted-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.55;
  }

  .hero-media {
    min-width: 0;
  }

  .window {
    overflow: hidden;
    border-radius: 0;
    border-left: none;
    border-right: none;
  }

  .window img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top left;
    background: #0c0f12;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 0;
  }

  .hero-stats div {
    padding: 1.1rem 1rem;
    border-right: 1px solid var(--line);
  }

  .hero-stats div:last-child {
    border-right: none;
  }

  .hero-stats dt {
    color: var(--muted-subtle);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-stats dd {
    margin: 0.4rem 0 0;
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .hero-stats p {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  @media (max-width: 620px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-stats {
      grid-template-columns: 1fr;
    }

    .hero-stats div {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }

    .hero-stats div:last-child {
      border-bottom: none;
    }
  }
</style>
