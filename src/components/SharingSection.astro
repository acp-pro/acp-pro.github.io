---
import { LockKeyhole, RadioTower, ShieldCheck, ToggleRight } from '@lucide/astro';

const controls = [
  {
    icon: RadioTower,
    title: 'Reach it on any screen',
    body: 'Use a LAN address or existing port forwarding; narrow layouts keep tabs, toolbar actions, and the More menu within reach.',
  },
  {
    icon: LockKeyhole,
    title: 'Gate every connection',
    body: 'The active share code is checked on HTTP routes and WebSocket upgrades.',
  },
  {
    icon: ToggleRight,
    title: 'Choose read or write access',
    body: 'Pro owners can unlock controls, then switch browser access between read-only and full-write.',
  },
  {
    icon: ShieldCheck,
    title: 'Keep each surface scoped',
    body: 'Browser preferences stay client-local, VS Code-only configuration stays in the editor, and the bridge can be disabled per workspace.',
  },
];
---

<section id="sharing" class="section sharing">
  <div class="page-shell">
    <div class="sharing-copy">
      <div class="section-heading">
        <div class="rule-tick" aria-hidden="true"></div>
        <p class="eyebrow">Remote workspace</p>
        <div class="rule" aria-hidden="true"></div>
        <h2>
          Step away without losing sight of the work.
          <span class="muted-line">Another view of the live workspace—not a screen recording.</span>
        </h2>
        <div class="rule" aria-hidden="true"></div>
        <p>
          Open the live workspace from a phone or desktop browser to check a
          long-running task, respond when it needs you, or share the same view
          with a teammate. It is another view of the workspace—not a recording
          of your screen.
        </p>
        <div class="rule" aria-hidden="true"></div>
      </div>

      <div class="control-list">
        {
          controls.map((control) => {
            const Icon = control.icon;
            return (
              <div class="control-item">
                <Icon size={18} aria-hidden="true" />
                <div>
                  <h3>{control.title}</h3>
                  <p>{control.body}</p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .sharing {
    background: var(--bg);
  }

  .sharing-copy {
    min-width: 0;
  }

  .section-heading .eyebrow {
    padding: 0.85rem 0;
  }

  .section-heading h2 {
    padding: 1rem 0;
    margin: 0;
  }

  .section-heading > p {
    padding: 1rem 0;
    margin: 0;
  }

  .control-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin-top: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .control-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    padding: 1.1rem 1rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .control-item:nth-child(2n) {
    border-right: none;
  }

  .control-item:nth-last-child(-n + 2) {
    border-bottom: none;
  }

  .control-item svg {
    margin-top: 2px;
    color: var(--muted);
  }

  .control-item h3 {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.3;
    font-weight: 600;
  }

  .control-item p {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  @media (max-width: 580px) {
    .control-list {
      grid-template-columns: 1fr;
    }

    .control-item {
      border-right: none;
    }

    .control-item:nth-last-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }

    .control-item:last-child {
      border-bottom: none;
    }
  }
</style>
