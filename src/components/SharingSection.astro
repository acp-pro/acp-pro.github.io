---
import { LockKeyhole, RadioTower, ShieldCheck, ToggleRight } from '@lucide/astro';

const controls = [
  {
    icon: RadioTower,
    title: 'Reach it where you are',
    body: 'Use a LAN address or your existing VS Code port-forwarding, Codespaces, or SSH setup.',
  },
  {
    icon: LockKeyhole,
    title: 'Gate every connection',
    body: 'The active share code is checked on HTTP routes and WebSocket upgrades.',
  },
  {
    icon: ToggleRight,
    title: 'Choose read or write access',
    body: 'Pro owners can unlock controls, then switch browser access between read-only and full-write.',
  },
  {
    icon: ShieldCheck,
    title: 'Keep it workspace scoped',
    body: 'Turn the browser bridge off for any workspace that should remain local.',
  },
];
---

<!-- @spec: cap-product-homepage/screenshot-led-workflow-story#understand-remote-access-beyond-teammate-sharing -->
<!-- @spec: cap-product-homepage/screenshot-led-workflow-story#product-screenshot-is-unavailable -->
<section id="sharing" class="section sharing">
  <div class="page-shell sharing-grid">
    <div class="sharing-copy">
      <div class="section-heading">
        <div class="rule-tick" aria-hidden="true"></div>
        <p class="eyebrow">Remote workspace</p>
        <div class="rule" aria-hidden="true"></div>
        <h2>
          Step away without losing sight of the work.
          <span class="muted-line">Another view of the live workspace—not a screen recording.</span>
        </h2>
        <div class="rule" aria-hidden="true"></div>
        <p>
          Open the live workspace from a phone or desktop browser to check a
          long-running task, respond when it needs you, or share the same view
          with a teammate. It is another view of the workspace—not a recording
          of your screen.
        </p>
        <div class="rule" aria-hidden="true"></div>
      </div>

      <div class="control-list">
        {
          controls.map((control) => {
            const Icon = control.icon;
            return (
              <div class="control-item">
                <Icon size={18} aria-hidden="true" />
                <div>
                  <h3>{control.title}</h3>
                  <p>{control.body}</p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <div class="access-proof dark-surface">
      <div class="access-proof-heading">
        <span>
          <RadioTower size={16} aria-hidden="true" />
          ACP SHA92C
        </span>
        <strong>Owner controlled</strong>
      </div>

      <figure class="access-shot">
        <figcaption>Copy a reachable browser link</figcaption>
        <img
          src="/assets/acp-pro-copy-share-url.jpg"
          alt="ACP Pro status menu listing reachable LAN addresses and a control to copy the browser share link"
          width="763"
          height="348"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="access-connector" aria-hidden="true">
        <span></span>
        <strong>Then</strong>
        <span></span>
      </div>

      <figure class="access-shot">
        <figcaption>Unlock owner controls when needed</figcaption>
        <img
          src="/assets/acp-pro-remote-control-password.jpg"
          alt="ACP Pro browser workspace requesting the owner password before enabling owner controls"
          width="1290"
          height="614"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .sharing {
    background: var(--bg);
  }

  .sharing-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 0.78fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 4.5rem);
  }

  .sharing-copy {
    min-width: 0;
  }

  .section-heading .eyebrow {
    padding: 0.85rem 0;
  }

  .section-heading h2 {
    padding: 1rem 0;
    margin: 0;
  }

  .section-heading > p {
    padding: 1rem 0;
    margin: 0;
  }

  .control-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin-top: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .control-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    padding: 1.1rem 1rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .control-item:nth-child(2n) {
    border-right: none;
  }

  .control-item:nth-last-child(-n + 2) {
    border-bottom: none;
  }

  .control-item svg {
    margin-top: 2px;
    color: var(--muted);
  }

  .control-item h3 {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.3;
    font-weight: 600;
  }

  .control-item p {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .access-proof {
    min-width: 0;
    overflow: hidden;
  }

  .access-proof-heading {
    display: flex;
    min-height: 52px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid #2a2a2a;
    padding: 0 1rem;
  }

  .access-proof-heading span {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 8px;
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .access-proof-heading span svg {
    flex: none;
    color: var(--accent);
  }

  .access-proof-heading strong {
    flex: none;
    border: 1px solid rgba(0, 208, 132, 0.32);
    border-radius: 999px;
    padding: 0.28rem 0.58rem;
    color: #9cf5cd;
    background: rgba(0, 208, 132, 0.08);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .access-shot {
    margin: 0;
    padding: 1rem;
  }

  .access-shot figcaption {
    margin-bottom: 0.65rem;
    color: #a3a3a3;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .access-shot img {
    width: 100%;
    height: auto;
    border: 1px solid #2f2f2f;
    border-radius: var(--radius-sm);
    background: #0c0f12;
  }

  .access-connector {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
    padding: 0 1rem;
    color: #737373;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .access-connector span {
    height: 1px;
    background: #2a2a2a;
  }

  @media (max-width: 920px) {
    .sharing-grid {
      grid-template-columns: 1fr;
    }

    .access-proof {
      width: min(100%, 640px);
    }
  }

  @media (max-width: 580px) {
    .control-list {
      grid-template-columns: 1fr;
    }

    .control-item {
      border-right: none;
    }

    .control-item:nth-last-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }

    .control-item:last-child {
      border-bottom: none;
    }

    .access-proof-heading {
      align-items: flex-start;
      flex-direction: column;
      padding-block: 0.85rem;
    }
  }
</style>
