---
const workflows = [
  {
    number: '01',
    reverse: false,
    title: 'Pick the agent for the task.',
    mutedTitle: 'A separate session for each one.',
    body: 'Claude Code, Codex, Copilot, and the other built-ins launch in their own tab. Model, permissions, directory, and history stay with that tab.',
    benefit: 'Switch agents without opening another product.',
    shot: {
      image: '/assets/acp-pro-demo-poster.jpg',
      width: 1280,
      height: 800,
      label: 'Choose an agent',
      alt: 'ACP Pro in VS Code with the agent picker beside an open TypeScript file',
    },
  },
  {
    number: '02',
    reverse: true,
    title: 'Read the run before you accept it.',
    mutedTitle: 'The plan, the diff, and the cost stay visible.',
    body: 'Tool calls stream with status. File changes render as diffs. Answers can include tables and diagrams, with token and cost figures beside the model and permission mode.',
    benefit: 'Accept a result after the evidence is on screen.',
    shot: {
      image: '/assets/acp-pro-demo-run.jpg',
      width: 1600,
      height: 1000,
      label: 'Follow the run',
      alt: 'ACP Pro after a Claude Code turn: a rate-limit diagram, completed tasks, token and cost usage, and the model and permission controls',
    },
  },
  {
    number: '03',
    reverse: false,
    title: 'Leave the desk and keep the session.',
    mutedTitle: 'The same workspace, open in a browser.',
    body: 'Check a long run, respond when the agent is waiting, or send the next prompt from a phone. Browser access can be turned off per workspace. Pro adds a persistent access code, an owner password, and read-only or full-write mode.',
    benefit: 'The session stays in VS Code while you are away from the desk.',
    shot: {
      image: '/assets/acp-pro-demo-phone.jpg',
      width: 1600,
      height: 1000,
      label: 'Phone browser',
      alt: 'The same ACP Pro session open in VS Code and in a phone browser, with the composer ready on both',
    },
  },
];
---

<section id="workflow" class="section workflow">
  <div class="page-shell">
    <div class="section-heading">
      <div class="rule-tick" aria-hidden="true"></div>
      <p class="eyebrow">How it works</p>
      <div class="rule" aria-hidden="true"></div>
      <h2>
        Pick an agent. Watch the run. Take it with you.
        <span class="muted-line">One workspace for the session, the evidence, and a browser view.</span>
      </h2>
      <div class="rule" aria-hidden="true"></div>
      <p>
        Start Claude Code on one tab and Codex on the next. The diff stays in
        the transcript, and a phone can open that same session.
      </p>
      <div class="rule" aria-hidden="true"></div>
    </div>

    <div class="workflow-list">
      {
        workflows.map((workflow) => (
          <article class:list={['workflow-item', { reverse: workflow.reverse }]}>
            <figure class="workflow-shot dark-surface">
              <figcaption>{workflow.shot.label}</figcaption>
              <img
                src={workflow.shot.image}
                alt={workflow.shot.alt}
                width={workflow.shot.width}
                height={workflow.shot.height}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="workflow-copy">
              <span class="workflow-number" aria-hidden="true">{workflow.number}</span>
              <h3>
                {workflow.title}
                <span class="muted-line">{workflow.mutedTitle}</span>
              </h3>
              <p>{workflow.body}</p>
              <div class="workflow-benefit">
                <strong>Why it helps</strong>
                <p>{workflow.benefit}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .workflow {
    overflow: hidden;
    background: var(--bg);
  }

  .section-heading .rule-tick,
  .section-heading .rule {
    margin-inline: 0;
  }

  .section-heading .eyebrow {
    padding: 0.85rem 0;
  }

  .section-heading h2 {
    padding: 1rem 0;
    margin: 0;
  }

  .section-heading > p {
    padding: 1rem 0;
    margin: 0;
  }

  .workflow-list {
    display: grid;
    gap: clamp(4.5rem, 9vw, 7rem);
    margin-top: clamp(2.75rem, 6vw, 4.5rem);
  }

  .workflow-item {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(280px, 0.68fr);
    align-items: center;
    gap: clamp(28px, 5vw, 64px);
  }

  .workflow-item.reverse {
    grid-template-columns: minmax(280px, 0.68fr) minmax(0, 1.12fr);
  }

  .workflow-item.reverse .workflow-shot {
    order: 2;
  }

  .workflow-shot {
    position: relative;
    min-width: 0;
    margin: 0;
    overflow: hidden;
  }

  .workflow-shot img {
    display: block;
    width: 100%;
    height: auto;
    background: #0c0f12;
  }

  .workflow-shot figcaption {
    position: absolute;
    z-index: 2;
    top: 10px;
    left: 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    padding: 0.32rem 0.62rem;
    color: #f5f5f5;
    background: rgba(10, 10, 10, 0.88);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .workflow-copy {
    min-width: 0;
  }

  .workflow-number {
    display: inline-flex;
    color: var(--muted-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .workflow-copy h3 {
    margin: 0.7rem 0 0;
    font-size: clamp(1.45rem, 2.8vw, 2.15rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .workflow-copy h3 .muted-line {
    display: block;
    color: var(--muted);
    font-weight: 600;
  }

  .workflow-copy > p {
    margin: 0.95rem 0 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .workflow-benefit {
    margin-top: 1.35rem;
    border-top: 1px solid var(--line);
    padding-top: 0.95rem;
  }

  .workflow-benefit strong {
    display: block;
    color: var(--muted-subtle);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .workflow-benefit p {
    margin: 0.4rem 0 0;
    color: var(--ink);
    font-weight: 600;
    line-height: 1.45;
  }

  @media (max-width: 820px) {
    .workflow-item,
    .workflow-item.reverse {
      grid-template-columns: 1fr;
      gap: 1.35rem;
    }

    .workflow-item.reverse .workflow-shot {
      order: 0;
    }
  }

  @media (max-width: 520px) {
    .workflow-shot figcaption {
      top: 7px;
      left: 7px;
      font-size: 0.64rem;
    }
  }
</style>
