---
// @spec: cap-product-homepage/screenshot-led-workflow-story#understand-the-end-to-end-workflow
// @spec: cap-product-homepage/screenshot-led-workflow-story#product-screenshot-is-unavailable
const workflows = [
  {
    number: '01',
    kind: 'execution',
    reverse: true,
    title: 'Keep the whole run in view.',
    mutedTitle: 'Evidence before you accept the result.',
    body: 'Plans, streamed tool calls, file diffs, git context, token and cost usage, model controls, and permission mode stay visible around the conversation.',
    benefit:
      'Review the evidence, cost, and completion state before accepting an agent’s result.',
    primary: {
      image: '/assets/acp-pro-sidebar-demo.jpg',
      width: 2586,
      height: 1506,
      label: 'Follow live execution',
      alt: 'ACP Pro sidebar showing parallel sessions, a live file diff, completed tool calls, git context, and composer controls',
    },
    detail: {
      image: '/assets/acp-pro-tasks-plan-toolbar.jpg',
      width: 956,
      height: 474,
      label: 'Plans and controls',
      alt: 'ACP Pro task plan, token and cost usage, model toolbar, permission control, and message composer',
    },
  },
  {
    number: '02',
    kind: 'agents',
    reverse: false,
    title: 'Build the agent lineup that fits the task.',
    mutedTitle: 'Registry in, editor-tab settings tuned, ready to run.',
    body: 'Browse the ACP Registry, add compatible agents, then manage agents, appearance, license, and extension details from one reusable VS Code editor tab.',
    benefit:
      'Keep specialized agents ready without hard-coding the workspace to one provider.',
    primary: {
      image: '/assets/acp-pro-agents-registry.jpg',
      width: 1242,
      height: 812,
      label: 'Browse the registry',
      alt: 'ACP Pro agent registry open in VS Code with compatible coding agents ready to add',
    },
    detail: {
      image: '/assets/acp-pro-agents-settings.jpg',
      width: 1253,
      height: 969,
      label: 'Configure your lineup',
      alt: 'ACP Pro agent settings with editable transport, command, arguments, and environment controls',
    },
  },
  // @spec: cap-product-homepage/screenshot-led-workflow-story#understand-remote-access-beyond-teammate-sharing
  {
    number: '03',
    kind: 'remote',
    reverse: true,
    title: 'Take the live workspace with you.',
    mutedTitle: 'Same session. Phone or desktop browser.',
    body: 'Open the same workspace in a desktop or phone browser. Check a long-running task after you step away, intervene when needed, or invite a teammate to review the live evidence.',
    benefit:
      'Agent work stays observable beyond your desk—without moving the session out of VS Code.',
    primary: {
      image: '/assets/acp-pro-remote-control-web.jpg',
      width: 2492,
      height: 1568,
      label: 'Desktop browser',
      alt: 'ACP Pro live workspace open in a desktop browser with agent tabs, tool results, and a file diff',
    },
    detail: {
      image: '/assets/acp-pro-remote-iPhone-browser.jpg',
      width: 1290,
      height: 2796,
      label: 'Phone browser',
      alt: 'ACP Pro live workspace on a phone browser showing agent progress, diffs, usage, controls, and the composer',
    },
  },
];
---

<section id="workflow" class="section workflow">
  <div class="page-shell">
    <div class="section-heading">
      <div class="rule-tick" aria-hidden="true"></div>
      <p class="eyebrow">How it works</p>
      <div class="rule" aria-hidden="true"></div>
      <h2>
        From agent setup to work that follows you.
        <span class="muted-line">Inspectable in the IDE. Reachable in a browser.</span>
      </h2>
      <div class="rule" aria-hidden="true"></div>
      <p>
        Choose the right agents, keep every step inspectable, and open the same
        live workspace in a browser when you move away from VS Code.
      </p>
      <div class="rule" aria-hidden="true"></div>
    </div>

    <div class="workflow-list">
      {
        workflows.map((workflow) => (
          <article
            class:list={[
              'workflow-item',
              `workflow-${workflow.kind}`,
              { reverse: workflow.reverse },
            ]}
          >
            <div class="workflow-visual">
              <figure class="workflow-shot workflow-primary dark-surface">
                <figcaption>{workflow.primary.label}</figcaption>
                <img
                  src={workflow.primary.image}
                  alt={workflow.primary.alt}
                  width={workflow.primary.width}
                  height={workflow.primary.height}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <figure class="workflow-shot workflow-detail dark-surface">
                <figcaption>{workflow.detail.label}</figcaption>
                <img
                  src={workflow.detail.image}
                  alt={workflow.detail.alt}
                  width={workflow.detail.width}
                  height={workflow.detail.height}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </div>
            <div class="workflow-copy">
              <span class="workflow-number" aria-hidden="true">{workflow.number}</span>
              <h3>
                {workflow.title}
                <span class="muted-line">{workflow.mutedTitle}</span>
              </h3>
              <p>{workflow.body}</p>
              <div class="workflow-benefit">
                <strong>Why it helps</strong>
                <p>{workflow.benefit}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .workflow {
    overflow: hidden;
    background: var(--bg);
  }

  .section-heading .rule-tick,
  .section-heading .rule {
    margin-inline: 0;
  }

  .section-heading .eyebrow {
    padding: 0.85rem 0;
  }

  .section-heading h2 {
    padding: 1rem 0;
    margin: 0;
  }

  .section-heading > p {
    padding: 1rem 0;
    margin: 0;
  }

  .workflow-list {
    display: grid;
    gap: clamp(4.5rem, 9vw, 7rem);
    margin-top: clamp(2.75rem, 6vw, 4.5rem);
  }

  .workflow-item {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(280px, 0.68fr);
    align-items: center;
    gap: clamp(28px, 5vw, 64px);
  }

  .workflow-item.reverse {
    grid-template-columns: minmax(280px, 0.68fr) minmax(0, 1.12fr);
  }

  .workflow-item.reverse .workflow-visual {
    order: 2;
  }

  .workflow-visual {
    position: relative;
    min-width: 0;
    padding: 0 clamp(28px, 4vw, 48px) clamp(40px, 6vw, 64px) 0;
  }

  .workflow-shot {
    margin: 0;
    overflow: hidden;
  }

  .workflow-shot img {
    width: 100%;
    height: auto;
    background: #0c0f12;
  }

  .workflow-shot figcaption {
    position: absolute;
    z-index: 2;
    top: 10px;
    left: 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    padding: 0.32rem 0.62rem;
    color: #f5f5f5;
    background: rgba(10, 10, 10, 0.88);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .workflow-primary {
    position: relative;
  }

  .workflow-detail {
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: 0;
    width: min(48%, 340px);
  }

  .workflow-execution .workflow-visual {
    padding-right: 0;
    padding-left: clamp(28px, 4vw, 48px);
  }

  .workflow-execution .workflow-detail {
    right: auto;
    left: 0;
    width: min(52%, 370px);
  }

  .workflow-remote .workflow-visual {
    padding-right: clamp(40px, 6vw, 72px);
  }

  .workflow-remote .workflow-detail {
    right: 8px;
    bottom: 8px;
    width: min(25%, 176px);
    border-radius: var(--radius-lg);
  }

  .workflow-copy {
    min-width: 0;
  }

  .workflow-number {
    display: inline-flex;
    color: var(--muted-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .workflow-copy h3 {
    margin: 0.7rem 0 0;
    font-size: clamp(1.45rem, 2.8vw, 2.15rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .workflow-copy h3 .muted-line {
    display: block;
    color: var(--muted);
    font-weight: 600;
  }

  .workflow-copy > p {
    margin: 0.95rem 0 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .workflow-benefit {
    margin-top: 1.35rem;
    border-top: 1px solid var(--line);
    padding-top: 0.95rem;
  }

  .workflow-benefit strong {
    display: block;
    color: var(--muted-subtle);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .workflow-benefit p {
    margin: 0.4rem 0 0;
    color: var(--ink);
    font-weight: 600;
    line-height: 1.45;
  }

  @media (max-width: 820px) {
    .workflow-item,
    .workflow-item.reverse {
      grid-template-columns: 1fr;
      gap: 1.35rem;
    }

    .workflow-item.reverse .workflow-visual {
      order: 0;
    }
  }

  @media (max-width: 520px) {
    .workflow-visual,
    .workflow-execution .workflow-visual,
    .workflow-remote .workflow-visual {
      display: grid;
      padding: 0;
    }

    .workflow-primary {
      grid-column: 1;
      grid-row: 1;
    }

    .workflow-detail,
    .workflow-execution .workflow-detail {
      position: relative;
      right: auto;
      left: auto;
      bottom: auto;
      grid-column: 1;
      grid-row: 2;
      width: 72%;
      margin-top: -28px;
      justify-self: end;
    }

    .workflow-execution .workflow-detail {
      justify-self: start;
    }

    .workflow-remote .workflow-detail {
      right: auto;
      bottom: auto;
      grid-column: 1;
      grid-row: 1 / span 2;
      align-self: end;
      width: 30%;
      margin: 0 8px -28px 0;
    }

    .workflow-shot figcaption {
      top: 7px;
      left: 7px;
      font-size: 0.64rem;
    }
  }
</style>
